<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FindThatBook.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1180"
             d:DesignHeight="760"
             x:Class="FindThatBook.Client.Views.MainWindow"
             x:DataType="vm:MainViewModel"
             Background="#F5F2EA"
             MinWidth="760">

    <UserControl.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#22231F" />
        <SolidColorBrush x:Key="MutedInkBrush" Color="#686960" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#315B4B" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#25483B" />
        <SolidColorBrush x:Key="HairlineBrush" Color="#DDD9CE" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="42" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="48" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontFamily" Value="Georgia" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="Button.search-button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.search-button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
        </Style>
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.result-card">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,18">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Georgia"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="-2">
                        <TextBlock Text="FIND THAT BOOK" Classes="eyebrow" />
                        <TextBlock Text="Library discovery" FontSize="12" Foreground="{StaticResource MutedInkBrush}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="12,7"
                        CornerRadius="20"
                        Background="#E9EFEA">
                    <TextBlock Text="OPEN LIBRARY"
                               Classes="eyebrow"
                               LetterSpacing="0.8"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Grid Margin="40,54,40,44" MaxWidth="1040" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnDefinitions="3*,2*">
                    <StackPanel Grid.Column="0" Spacing="16" Margin="0,0,48,0">
                        <TextBlock Text="SEARCH YOUR NEXT READ" Classes="eyebrow" />
                        <TextBlock Text="A half-remembered story is enough."
                                   Classes="title"
                                   TextWrapping="Wrap"
                                   MaxWidth="650" />
                        <TextBlock
                            Text="Enter any title fragment, author, character, plot detail, or stray keyword you can remember."
                            FontSize="17"
                            LineHeight="27"
                            Foreground="{StaticResource MutedInkBrush}"
                            TextWrapping="Wrap"
                            MaxWidth="620" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#E7E0D2"
                            CornerRadius="22"
                            Padding="30"
                            MinHeight="190">
                        <StackPanel VerticalAlignment="Center" Spacing="14">
                            <TextBlock Text="TRY SOMETHING MESSY" Classes="eyebrow" Foreground="#856B43" />
                            <TextBlock Text="“A boy at a strange school, probably British, with magic.”"
                                       FontFamily="Georgia"
                                       FontStyle="Italic"
                                       FontSize="20"
                                       LineHeight="29"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="Titles, authors, and details can all live in one query."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Margin="0,42,0,50"
                        Padding="10"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}"
                        BorderThickness="1"
                        CornerRadius="17"
                        BoxShadow="0 12 32 0 #18000000">
                    <Grid ColumnDefinitions="Auto,*,Auto" Height="58">
                        <PathIcon Grid.Column="0"
                                  Width="21"
                                  Height="21"
                                  Margin="14,0,4,0"
                                  Foreground="{StaticResource MutedInkBrush}"
                                  VerticalAlignment="Center"
                                  Data="M9.5,3 A6.5,6.5 0 1 0 9.5,16 A6.5,6.5 0 1 0 9.5,3 M14.3,14.3 L20,20" />
                        <TextBox Grid.Column="1"
                                 Classes="search-box"
                                 Text="{Binding SearchQuery}"
                                 PlaceholderText="What do you remember?">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="2"
                                Classes="search-button"
                                Command="{Binding SearchCommand}"
                                Content="Search books"
                                MinWidth="142" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Spacing="18">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Candidates" Classes="section-title" />
                            <TextBlock Text="The strongest matches will appear here."
                                       FontSize="14"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ResultCountText}"
                                   Classes="eyebrow"
                                   Foreground="{StaticResource MutedInkBrush}"
                                   VerticalAlignment="Bottom" />
                    </Grid>

                    <Border Height="200"
                            IsVisible="{Binding ShowInitialState}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="10">
                            <Border Width="48" Height="48" CornerRadius="24" Background="#E9EFEA">
                                <TextBlock Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Georgia"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="Your shelf is waiting"
                                       FontFamily="Georgia"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Start with anything you remember about the book."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedInkBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border Height="160"
                            IsVisible="{Binding IsSearching}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="14">
                            <ProgressBar Width="220" IsIndeterminate="True" />
                            <TextBlock Text="Searching Open Library…"
                                       FontFamily="Georgia"
                                       FontSize="18"
                                       FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <Border Height="180"
                            IsVisible="{Binding ShowEmptyState}"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="18">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="9">
                            <TextBlock Text="No likely matches"
                                       FontFamily="Georgia"
                                       FontSize="18"
                                       FontWeight="Bold" />
                            <TextBlock Text="Try adding a character, plot detail, author, or approximate year."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedInkBrush}" />
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasError}"
                            Background="#FAE9E5"
                            BorderBrush="#D9A297"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Search unavailable"
                                       FontWeight="Bold"
                                       Foreground="#7A3026" />
                            <TextBlock Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="#7A3026" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Candidates}"
                                  IsVisible="{Binding ShowResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BookCandidateViewModel">
                                <Border Classes="result-card">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0"
                                                Width="72"
                                                Height="106"
                                                Margin="0,0,20,0"
                                                CornerRadius="7"
                                                Background="#E7E0D2"
                                                ClipToBounds="True">
                                            <Grid>
                                                <TextBlock Text="B"
                                                           IsVisible="{Binding ShowCoverPlaceholder}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontFamily="Georgia"
                                                           FontSize="23"
                                                           FontWeight="Bold"
                                                           Foreground="#856B43" />
                                                <Image Source="{Binding CoverImage}"
                                                       IsVisible="{Binding HasCoverImage}"
                                                       Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Title}"
                                                           FontFamily="Georgia"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap" />
                                                <Border Grid.Column="1"
                                                        Margin="16,0,0,0"
                                                        Padding="10,5"
                                                        CornerRadius="12"
                                                        Background="#E9EFEA"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Confidence}"
                                                               Classes="eyebrow"
                                                               FontSize="11"
                                                               LetterSpacing="0.4" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Authors}"
                                                       FontSize="14"
                                                       Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock
                                                Text="{Binding FirstPublishYear, StringFormat='First published {0}'}"
                                                FontSize="12"
                                                Foreground="{StaticResource MutedInkBrush}" />
                                            <TextBlock Text="{Binding Explanation}"
                                                       Margin="0,4,0,0"
                                                       FontSize="14"
                                                       LineHeight="21"
                                                       TextWrapping="Wrap" />
                                            <HyperlinkButton Content="View on Open Library ↗"
                                                             NavigateUri="{Binding OpenLibraryUri}"
                                                             IsVisible="{Binding HasOpenLibraryUri}"
                                                             HorizontalAlignment="Left"
                                                             Padding="0"
                                                             Foreground="{StaticResource AccentBrush}"
                                                             FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>